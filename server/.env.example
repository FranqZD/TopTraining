# --- Base ---
DATABASE_URL="file:./dev.db"
# Generar con: openssl rand -base64 32
BETTER_AUTH_SECRET=""
BETTER_AUTH_URL="http://localhost:8787"
APP_URL="http://localhost:5173"
PORT=8787

# --- Fotos (R2 + Image Transformations; opcional en dev) ---
# Dashboard de Cloudflare > R2. Sin esto, el check-in funciona igual pero sin foto.
# Crear un bucket, un API token (Object Read & Write) y un dominio público
# (custom domain o r2.dev). CORS del bucket, orígenes de la app:
#   AllowedOrigins: APP_URL
#   AllowedMethods: PUT, GET, HEAD
#   AllowedHeaders: Content-Type
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET=""
# URL pública del bucket, sin barra final. Ej: https://img.tudominio.com
R2_PUBLIC_URL=""
# Zona con Image Transformations habilitadas. Vacío en local.
# Ej: https://tudominio.com/cdn-cgi/image
# Hay que permitir R2_PUBLIC_URL como origen de las transforms.
IMAGE_TRANSFORM_BASE=""

# --- Push (recordatorios de entreno; opcional en dev) ---
# Generar el par de claves con:  npx web-push generate-vapid-keys
# Sin esto la app funciona igual, solo que sin recordatorios.
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:hola@toptraining.app"
# Cada cuántos minutos revisa el job quién no marcó todavía.
PUSH_SWEEP_MINUTES=10
