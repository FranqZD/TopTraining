# --- Base ---
DATABASE_URL="file:./dev.db"
# Generar con: openssl rand -base64 32
BETTER_AUTH_SECRET=""
BETTER_AUTH_URL="http://localhost:8787"
APP_URL="http://localhost:5173"
PORT=8787

# --- Google OAuth (opcional en dev) ---
# console.cloud.google.com > Credenciales > ID de cliente OAuth (app web)
# Redirect URI: http://localhost:8787/api/auth/callback/google
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# --- Apple OAuth (opcional en dev; requiere Apple Developer Program de pago) ---
# El client secret es un JWT firmado con la clave .p8, válido máx. 6 meses.
# Redirect URI: http://localhost:8787/api/auth/callback/apple
APPLE_CLIENT_ID=""
APPLE_CLIENT_SECRET=""
APPLE_APP_BUNDLE_IDENTIFIER=""

# --- Cloudinary (fotos de check-in; opcional en dev) ---
# cloudinary.com > Dashboard. Sin esto, el check-in funciona igual pero sin foto.
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
