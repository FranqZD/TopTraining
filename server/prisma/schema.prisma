// Top Training — schema
//
// Los modelos User / Session / Account / Verification son los que exige
// better-auth. User además lleva los campos de producto de Top Training
// (declarados en auth.ts como `user.additionalFields`).

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model User {
  id            String   @id @default(cuid())
  name          String
  email         String   @unique
  emailVerified Boolean  @default(false)
  image         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // --- Perfil de Top Training (se completa en el onboarding) ---
  /// Paleta de acento elegida. Ver ThemeId en el frontend.
  theme               String  @default("ember")
  /// morning | afternoon | night
  trainingSlot        String?
  targetWeightKg      Float?
  /// Entrenos por semana declarados en el onboarding (1..7)
  weeklyFrequency     Int?
  /// Zona horaria IANA del dispositivo ("America/Argentina/Buenos_Aires").
  /// La necesita el cron para saber qué hora es PARA EL USUARIO.
  timeZone            String?
  /// Código para que un amigo te agregue sin buscar por nombre.
  friendCode          String  @unique
  onboardingCompleted Boolean @default(false)

  // --- Interruptores de avisos, uno por tipo (ver push.ts) ---
  // Todos prendidos: el que no los quiera, los apaga en Ajustes.
  /// Recordatorio de entrenar, el del job.
  notifyNudge    Boolean @default(true)
  /// Alguien de tus grupos marcó su entreno.
  notifyPosts    Boolean @default(true)
  /// Comentaron tu entreno.
  notifyComments Boolean @default(true)
  /// Te dieron aura o laura.
  notifyVotes    Boolean @default(true)
  /// Te llegó una solicitud de amistad.
  notifyFriends  Boolean @default(true)

  sessions Session[]
  accounts Account[]
  checkIns CheckIn[]
  sentRequests     Friendship[]  @relation("FriendshipSent")
  receivedRequests Friendship[]  @relation("FriendshipReceived")
  ownedGroups      Group[]       @relation("GroupOwner")
  groupMemberships GroupMember[]
  comments         Comment[]
  votes            Vote[]
  pushSubscriptions PushSubscription[]
  pushLogs          PushLog[]

  @@map("user")
}

model Session {
  id        String   @id @default(cuid())
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id @default(cuid())
  /// Emisor de la identidad. better-auth usa "local:..." para email+password
  /// y "local:oauth:<provider>" / el issuer real del proveedor para OAuth.
  issuer                String
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  /// Hash argon2id. Null en cuentas de Google/Apple.
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@unique([issuer, accountId])
  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

// --- Dominio de Top Training ---------------------------------------------

/// Solicitud de amistad. Una sola fila por par, con dirección:
/// `requester` la mandó, `addressee` la tiene que aceptar.
/// Son amigos recién cuando status == "accepted".
model Friendship {
  id          String    @id @default(cuid())
  requesterId String
  addresseeId String
  /// pending | accepted
  status      String    @default("pending")
  createdAt   DateTime  @default(now())
  respondedAt DateTime?

  requester User @relation("FriendshipSent", fields: [requesterId], references: [id], onDelete: Cascade)
  addressee User @relation("FriendshipReceived", fields: [addresseeId], references: [id], onDelete: Cascade)

  @@unique([requesterId, addresseeId])
  @@index([addresseeId, status])
  @@map("friendship")
}

/// Grupo de entrenamiento. La meta base es del grupo; cada miembro puede
/// pisarla con la suya (ver GroupMember.personalGoal).
model Group {
  id         String   @id @default(cuid())
  name       String
  /// Entrenos por semana que el grupo se propone: 3, 4 o 5.
  baseGoal   Int
  /// Código para sumarse sin que nadie te invite a mano.
  inviteCode String   @unique
  ownerId    String
  createdAt  DateTime @default(now())

  owner   User          @relation("GroupOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  members GroupMember[]
  recaps  GroupRecap[]

  @@map("group")
}

/// Recap mensual congelado. Se genera el día 1 para el mes que terminó y no
/// se vuelve a tocar: es una foto de cómo le fue al grupo ese mes.
///
/// `data` guarda el recap ya calculado en JSON. Es un snapshot de presentación,
/// no una fuente de verdad: si mañana alguien borra un check-in viejo, el
/// recap de marzo tiene que seguir diciendo lo que decía en abril.
model GroupRecap {
  id          String   @id @default(cuid())
  groupId     String
  /// Mes del recap, "YYYY-MM".
  month       String
  data        String
  generatedAt DateTime @default(now())

  group Group @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@unique([groupId, month])
  @@map("group_recap")
}

model GroupMember {
  id      String @id @default(cuid())
  groupId String
  userId  String
  /// Meta propia dentro del grupo. Si es null, hereda `Group.baseGoal`.
  personalGoal Int?
  /// owner | member
  role     String   @default("member")
  joinedAt DateTime @default(now())

  group Group @relation(fields: [groupId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([groupId, userId])
  @@index([userId])
  @@map("group_member")
}

model CheckIn {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// Día local del check-in, "YYYY-MM-DD". Un check-in por día y usuario.
  day    String
  /// Descripción libre. Opcional: el check-in se confirma con un solo toque.
  note   String?
  /// Foto en R2. Opcional.
  photoUrl      String?
  /// Key del objeto en R2, para poder borrar el archivo si se borra el check-in.
  photoPublicId String?
  createdAt DateTime @default(now())

  /// Además de garantizar un check-in por día, este índice único es el que
  /// resuelve "último check-in de un usuario" (userId + day desc) sin scan.
  comments Comment[]
  votes    Vote[]

  @@unique([userId, day])
  @@map("checkin")
}

/// Un dispositivo suscripto al push. Un usuario puede tener varios
/// (teléfono, tablet, escritorio) y cada uno es una fila.
model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  /// URL del servicio de push del navegador. Identifica al dispositivo.
  endpoint  String   @unique
  p256dh    String
  auth      String
  userAgent String?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("push_subscription")
}

/// Registro de lo que ya mandamos. El índice único es lo que garantiza
/// "una notificación por usuario por día": si la fila existe, no se manda.
model PushLog {
  id        String   @id @default(cuid())
  userId    String
  /// Día local del usuario, "YYYY-MM-DD".
  day       String
  /// Tipo de aviso. Hoy solo "nudge" (todavía estás a tiempo).
  kind      String
  sentAt    DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, day, kind])
  @@map("push_log")
}

/// Voto en un check-in: `like` (aura) o `laura`. Cada uno tiene uno de cada
/// por día — y solo si entrenó ese día. Los dos pueden ir a posts distintos,
/// pero en un mismo post es uno u otro.
model Vote {
  id        String   @id @default(cuid())
  checkInId String
  userId    String
  /// like | laura
  kind      String
  /// Día local del votante, "YYYY-MM-DD". Es el que raciona los votos.
  day       String
  createdAt DateTime @default(now())

  checkIn CheckIn @relation(fields: [checkInId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([checkInId, userId, kind])
  /// Uno de cada tipo por día: el índice es lo que lo garantiza, no el código.
  @@unique([userId, day, kind])
  @@index([checkInId])
  @@map("vote")
}

/// Comentario en el check-in de otro. Puede comentar cualquier miembro de
/// algún grupo que comparta con el autor del check-in.
model Comment {
  id        String   @id @default(cuid())
  checkInId String
  userId    String
  body      String
  createdAt DateTime @default(now())

  checkIn CheckIn @relation(fields: [checkInId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([checkInId, createdAt])
  @@map("comment")
}
