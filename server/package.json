{
  "name": "toptraining-server",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "prisma db push && node dist/index.js",
    "db:push": "prisma db push",
    "db:generate": "prisma generate",
    "db:studio": "prisma studio",
    "auth:generate": "better-auth generate --config src/auth.ts --output ../prisma/schema.prisma",
    "test:streaks": "tsx streaks-check.ts",
    "db:seed": "tsx prisma/seed-dev.ts",
    "test:scheduler": "tsx scheduler-check.ts",
    "test": "npm run test:streaks && npm run test:scheduler && npm run test:recap",
    "test:recap": "tsx recap-check.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1114.0",
    "@aws-sdk/s3-request-presigner": "^3.1114.0",
    "@libsql/client": "^0.17.4",
    "@prisma/adapter-libsql": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "better-auth": "^1.7.1",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "web-push": "^3.6.7",
    "zod": "^4.4.3"
  },
  "engines": {
    "node": "22.x"
  },
  "devDependencies": {
    "@better-auth/cli": "^1.4.22",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^26.2.0",
    "@types/web-push": "^3.6.4",
    "prisma": "^7.9.1",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2"
  }
}
